{
  "functions": { "api/ai.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, private" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ],
  "rewrites": [
    { "source": "/((?!api/|assets/|sw.js|manifest.json|icon.svg).*)", "destination": "/index.html" }
  ]
}
