# Configure these in Sites runtime settings, never in browser code.
# Exact invitations, bound once to stable authenticated Sites user IDs.
SIFRAN_GAIRO_EMAIL=
SIFRAN_RICARDO_EMAIL=
# Optional one-time account transfer, authorized only in server settings.
# Requires all three values and an exact matching invitation above.
# Example: SIFRAN_GAIRO_REBIND_FROM_USER_ID, _TO_EMAIL, _UNTIL (ISO UTC).
# Never commit identity values. After activation, remove the transfer grant.
# Optional AI provider. No key means an explicit unavailable state.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
